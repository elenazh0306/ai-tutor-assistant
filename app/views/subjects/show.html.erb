
  <div class="col">
    <h1><%= @subject.name %></h1>

  </div>
  <div class="col-md-3">
    <h2>Chats</h2>
    <div class="mb-4">
      <% if @chats.any? %>
        <ul>
          <% @chats.each do |chat| %>
            <li><%= link_to chat.title, chat_path(chat) %></li>
          <% end %>
        </ul>
        <%= simple_form_for [@subject, Chat.new] do |f| %>
          <%= f.button :submit, "Start New Chat", class: "btn btn-primary" %>
        <% end %>
      <% else %>
      <%= simple_form_for [@subject, Chat.new] do |f| %>
        <%= f.button :submit, "Start New Chat", class: "btn btn-primary" %>
      <% end %>

      <% end %>
    </div>
  </div>
