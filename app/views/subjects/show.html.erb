

  <div class="col">
    <h1><%= @subject.name %></h1>

  </div>

  <div> <!-- style this as a nice dashboard? -->
    <%= link_to "Back to Subjects", subjects_path %>
    <%= link_to "Create Study Materials", new_subject_material_path(@subject) %>
    <%= link_to "Test me on this Subject", new_subject_test_path(@subject) %>
    <%= link_to "Delete Subject", subject_path(@subject), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this subject?"} %>
  </div>

  <div class="col-md-3">
    <h2>Chats</h2>
    <div class="mb-4">
      <% if @chats.any? %>
        <ul>
          <% @chats.each do |chat| %>
            <li><%= link_to chat.title, chat_path(chat) %></li>
          <% end %>
        </ul>
        <%= simple_form_for [@subject, Chat.new] do |f| %>
          <%= f.button :submit, "Start New Chat", class: "btn btn-primary" %>
        <% end %>
      <% else %>
      <%= simple_form_for [@subject, Chat.new] do |f| %>
        <%= f.button :submit, "Start New Chat", class: "btn btn-primary" %>
      <% end %>

      <% end %>
    </div>

  <div class="col-md-3">
    <h2>Materials</h2>
    <div class="mb-4">
      <% if @subject.materials.any? %>
        <ul>
          <% @subject.materials.each do |material| %>
            <li><%= link_to material.title, subject_material_path(@subject, material) %></li>
          <% end %>
        </ul>

      <% else %>
      <p>There are no materials to review yet</p>

      <% end %>
    </div>

    <div class="col-md-3">
    <h2>Tests</h2>
    <div class="mb-4">
      <% if @subject.tests.any? %>
        <ul>
          <% @subject.tests.each do |test| %>
            <li><%= link_to test.title, subject_test_path(@subject, test) %></li>
          <% end %>
        </ul>

      <% else %>
      <p>There are no tests yet</p>

      <% end %>
    </div>
  </div>
