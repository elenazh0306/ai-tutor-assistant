
<div class = "container py-4 subject-page">
  <div>
    <%= link_to "← Back to Subjects", subjects_path, class: "text-decoration-none text-secondary fs-4" %>
  </div>

  <div class = "d-flex justify-content-center align-items-center gap-4 mb-5">
    <h1 class = "mb-3"><%= @subject.name %></h1>
    <button
    class = "btn btn-outline-secondary mb-3"
    type = "button"
    data-bs-toggle = "collapse"
    data-bs-target = "#subjectActions"
    aria-expanded = "false"
    aria-controls = "subjectActions">
    ⚙
    </button>
  </div>

  <div class = "d-flex justify-content-center align-items-center">
    <div class = "collapse" id = "subjectActions">
      <%= link_to "Create Study Materials", new_subject_material_path(@subject), class: "btn btn-primary fs-4" %>
      <%= link_to "Test Me on This Subject", new_subject_test_path(@subject), class: "btn btn-success fs-4" %>
      <%= link_to "Delete Subject", subject_path(@subject), class: "btn btn-outline-danger fs-4", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this subject?"} %>
    </div>
    <div class = "row justify-content-center g-3 mt-2">
      <div class = "col-12 col-md-6 text-center">
        <div class = "card border-0 bg-transparent">
          <div class = "card-body  card-subject-show ">
            <h2>💬 Chats</h2>
            <p class = "text-muted">Ask questions and study this subject with your AI tutor!</p>
            <% if @chats.any? %>
              <% @chats.each do |chat| %>
                <p><%= link_to chat.title, chat_path(chat), class: "fs-4 list-items" %></p>
              <% end %>
              <%= render "start_chat_form" %>
            <% else %>
            <%= render "start_chat_form" %>
            <% end %>
          </div>
        </div>

        <div class = "card border-0 bg-transparent">
          <div class = "card-body">
            <h2>📖 Materials</h2>
            <% if @subject.materials.any? %>
                <% @subject.materials.each do |material| %>
                  <p><%= link_to material.title, subject_material_path(@subject, material), class: "fs-4 list-items" %></p>
                <% end %>
            <% else %>
            <p class = "text-muted">There are no materials to review yet</p>
            <% end %>
          </div>
        </div>

        <div class = "card border-0 bg-transparent">
          <div class = "card-body">
            <h2>✏️ Tests</h2>
            <% if @subject.tests.any? %>
                <% @subject.tests.each do |test| %>
                  <p><%= link_to test.title, subject_test_path(@subject, test), class: "fs-4 list-items" %></p>
                <% end %>
                <%= render "start_test_form" %>
            <% else %>
            <p>There are no tests yet</p>
            <%= render "start_test_form" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>
