<div class = "subject-page d-flex align-items-center justify-content-center vh-100 fs-1">
  <div class="subjects-banner text-center" style="width: 500px">

      <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="form-inputs">
          <%= f.input :email,
                      required: false,
                      autofocus: true,
                      input_html: { autocomplete: "email" } %>
          <%= f.input :password,
                      required: false,
                      input_html: { autocomplete: "current-password" } %>
        </div>

        <div class="form-actions fs-6">
          <%= f.button :submit, "Log in", class: "button-new" %>
        </div>
      <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
