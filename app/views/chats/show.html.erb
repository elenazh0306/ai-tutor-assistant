<%= turbo_stream_from @chat %>
<div class = "container py-4">
<div>
<%= link_to "← #{@subject.name}", subject_path(@subject), class: "text-decoration-none text-secondary chat-banner" %>
</div>

<div class="chat-title-container">
<h1 id="chat_title" class="chat-title"><%= @chat.title %></h1>
</div>
<div id="new_material_container" >
  <%= link_to 'Create materials',
          subject_materials_path(@subject, chat_id: @chat.id ),
          data: { turbo_method: :post },
          class: 'button-new' %>
</div>
  <div class="chat-page">
    <div class='chat-phone'>
      <div id="messages" class="mb-4 overflow-auto">
          <%= render @chat.messages %>
      </div>
      <div id="new_message_container">
        <%= render "messages/form", chat: @chat, message: Message.new %>
      </div>
    </div>
  </div>


</div>
