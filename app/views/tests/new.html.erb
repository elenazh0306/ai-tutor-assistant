<%= simple_form_for [@subject, @test] do |f| %>
 <h2><%= @test.title %></h2>
  <%= f.input :title, as: :hidden %>
  <%= f.input :quantity, as: :hidden %>
  <%= f.input :difficulty, as: :hidden %>

  <h3>Questions</h3>

  <%= f.simple_fields_for :questions do |q| %>
    <%= q.input :title, as: :hidden %>
    <%= q.object.title %>
    <%= q.input :answer, placeholder: "Type your answer here..." %>

  <% end %>
  <%= f.button :submit, "Submit Test", class: "btn-primary" %>

<% end %>

<%= link_to "Cancel", subject_path(@subject) %>
