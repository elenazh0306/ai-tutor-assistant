<div class="materials-container"> <!-- possible hero banner -->
  <div class="materials-header">
  <h1><%= @material.title %></h1>
  </div>

  <p><%= @material.content%></p>

<div class = "d-flex flex-column align-items-start gap-3 mt-4"> <!-- style this as a nice dashboard? -->
  <div class = "d-flex align items-center gap-3 mt-4">
    <%= link_to "Edit Study Materials", edit_subject_material_path(@subject, @material), class: "button-new" %>
    <!-- we pass both @subject and @material to the link helper because the path is /subjects/:subject_id/materials/:id -->
    <%= link_to "Delete This Material", subject_material_path(@subject, @material), class: "button-cancel", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this set of study materials?"} %>
  </div>
  <%= link_to "← Back to Subject", subject_path(@subject), class: "text-decoration-none text-secondary fs-4" %>
</div>
</div>
